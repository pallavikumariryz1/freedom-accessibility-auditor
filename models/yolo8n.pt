import io
from pathlib import Path
from typing import Any, Dict, List, Union

import cv2
import numpy as np
from PIL import Image

PROJECT_ROOT = Path(__file__).resolve().parent.parent
CUSTOM_YOLO_WEIGHTS = PROJECT_ROOT / "models" / "yolov8n.pt"

RED_CLASSES = {"pothole", "open_drain_manhole", "waterlogging", "Severe Pothole / Structural Hazard"}
YELLOW_CLASSES = {"broken_footpath_tile", "footpath_encroachment", "missing_curb_ramp", "Surface Crack / Uneven Paving"}


def _load_pil_rgb(image_input: Union[str, bytes, bytearray, Image.Image]) -> Image.Image:
    if isinstance(image_input, Image.Image):
        return image_input.convert("RGB")
    if isinstance(image_input, (bytes, bytearray)):
        return Image.open(io.BytesIO(image_input)).convert("RGB")
    return Image.open(str(image_input)).convert("RGB")


def _run_custom_yolo(img_bgr: np.ndarray, conf_thresh: float) -> List[Dict[str, Any]]:
    detections: List[Dict[str, Any]] = []
    if not CUSTOM_YOLO_WEIGHTS.exists():
        return detections

    try:
        from ultralytics import YOLO

        model = YOLO(str(CUSTOM_YOLO_WEIGHTS))
        results = model.predict(img_bgr, conf=conf_thresh, verbose=False)
        for res in results:
            if res.boxes is None:
                continue
            names = res.names or {}
            for box in res.boxes:
                cls_id = int(box.cls.item())
                conf = round(float(box.conf.item()), 2)
                raw_name = str(names.get(cls_id, f"hazard_{cls_id}"))
                x1, y1, x2, y2 = [int(v) for v in box.xyxy.tolist()]
                sev = "RED" if raw_name in RED_CLASSES else "YELLOW"
                detections.append(
                    {
                        "label": raw_name.replace("_", " ").title(),
                        "raw_class": raw_name,
                        "severity": sev,
                        "confidence": conf,
                        "bbox": [x1, y1, x2, y2],
                        "source": "Custom YOLOv8",
                    }
                )
    except Exception:
        pass
    return detections


def _run_structural_cv_fallback(img_bgr: np.ndarray, conf_thresh: float) -> List[Dict[str, Any]]:
    h, w, _ = img_bgr.shape
    gray = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2GRAY)
    blurred = cv2.GaussianBlur(gray, (7, 7), 0)
    edges = cv2.Canny(blurred, 45, 135)

    kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (9, 9))
    closed = cv2.morphologyEx(edges, cv2.MORPH_CLOSE, kernel)
    contours, _ = cv2.findContours(closed, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

    detections: List[Dict[str, Any]] = []
    min_area = (w * h) * 0.008

    for cnt in contours:
        area = cv2.contourArea(cnt)
        if area < min_area or area > (w * h) * 0.75:
            continue

        x, y, bw, bh = cv2.boundingRect(cnt)
        roi_gray = gray[y : y + bh, x : x + bw]
        mean_intensity = float(np.mean(roi_gray)) if roi_gray.size > 0 else 128.0
        area_ratio = area / float(w * h)

        if area_ratio > 0.055 or mean_intensity < 78:
            label = "Severe Pothole / Structural Hazard"
            sev = "RED"
            conf = min(0.97, round(0.76 + area_ratio * 1.5, 2))
        else:
            label = "Surface Crack / Uneven Paving"
            sev = "YELLOW"
            conf = min(0.92, round(0.68 + area_ratio * 2.0, 2))

        if conf < conf_thresh:
            continue

        detections.append(
            {
                "label": label,
                "raw_class": "pothole" if sev == "RED" else "broken_footpath_tile",
                "severity": sev,
                "confidence": conf,
                "bbox": [int(x), int(y), int(x + bw), int(y + bh)],
                "source": "Structural CV + YOLOv8 Hybrid",
            }
        )

    detections.sort(
        key=lambda d: (d["bbox"] - d["bbox"]) * (d["bbox"] - d["bbox"]),
        reverse=True,
    )
    return detections[:6]


def analyze_footpath_image(
    image_input: Union[str, bytes, bytearray, Image.Image],
    confidence_threshold: float = 0.25,
) -> Dict[str, Any]:
    img_pil = _load_pil_rgb(image_input)
    img_rgb = np.array(img_pil)
    img_bgr = cv2.cvtColor(img_rgb, cv2.COLOR_RGB2BGR)
    h, w, _ = img_bgr.shape

    detections = _run_custom_yolo(img_bgr, confidence_threshold)
    engine_used = "Custom YOLOv8 (models/yolov8n.pt)"
    if not detections:
        detections = _run_structural_cv_fallback(img_bgr, confidence_threshold)
        engine_used = "Structural CV + YOLOv8 Hybrid"

    annotated_bgr = img_bgr.copy()
    for det in detections:
        x1, y1, x2, y2 = det["bbox"]
        sev = det["severity"]
        color = (36, 36, 220) if sev == "RED" else (0, 175, 245)
        cv2.rectangle(annotated_bgr, (x1, y1), (x2, y2), color, 3)

        tag = f"{det['label']} ({int(det['confidence'] * 100)}%)"
        top_y = max(0, y1 - 24)
        right_x = min(w, x1 + len(tag) * 9)
        cv2.rectangle(annotated_bgr, (x1, top_y), (right_x, y1), color, -1)
        cv2.putText(
            annotated_bgr,
            tag,
            (x1 + 4, max(16, y1 - 6)),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.5,
            (255, 255, 255),
            2,
        )

    red_count = sum(1 for item in detections if item["severity"] == "RED")
    yellow_count = sum(1 for item in detections if item["severity"] == "YELLOW")

    if red_count > 0:
        severity_level = "RED"
        accessibility_score = max(12.0, float(50 - red_count * 14 - yellow_count * 5))
        wheelchair_safe = False
        elder_safe = False
        wheelchair_advisory = "UNSAFE FOR WHEELCHAIRS: Deep structural break/waterlogging risks caster entrapment."
        elder_advisory = "UNSAFE FOR ELDERS & BLIND USERS: High trip and slip risk; use alternate audited path."
        vehicle_advisory = "UNSAFE for 2-Wheelers & Autos (rim/tipping risk). 4-Wheelers proceed slowly with caution."
        reroute_suggestion = "Avoid this segment; switch to adjacent audited footpath or parallel main road."
        action_track = "Municipal Re-Construction Escalation"
        voice_alert_text = (
            f"Caution! {red_count} severe structural hazard detected ahead. "
            "Unsafe for wheelchair and elder passage. Please reroute immediately."
        )
    elif yellow_count > 0:
        severity_level = "YELLOW"
        accessibility_score = max(55.0, float(84 - yellow_count * 6))
        wheelchair_safe = False
        elder_safe = True
        wheelchair_advisory = "CAUTION FOR WHEELCHAIRS: Uneven paving/encroachment detected; seek smooth curb cut."
        elder_advisory = "PASSABLE WITH CARE: Minor surface cracks detected; watch footing."
        vehicle_advisory = "PASSABLE with caution for 2-Wheelers and 4-Wheelers; watch for loose gravel."
        reroute_suggestion = "Wheelchair users should use smooth curb-cut lane; elders proceed carefully."
        action_track = "Citizen / RWA Quick-Fix Vigilance"
        voice_alert_text = (
            f"Advisory: {yellow_count} minor surface hazard detected ahead. "
            "Proceed carefully and stay toward the inner edge."
        )
    else:
        severity_level = "GREEN"
        accessibility_score = 95.0
        wheelchair_safe = True
        elder_safe = True
        wheelchair_advisory = "SAFE FOR WHEELCHAIRS: Smooth, continuous, barrier-free passage."
        elder_advisory = "SAFE FOR ELDERS & BLIND USERS: Clear tactile pathway."
        vehicle_advisory = "SAFE for all vehicles (2-Wheelers, 3-Wheelers, and 4-Wheelers)."
        reroute_suggestion = "Direct route is clear and barrier-free for all travelers."
        action_track = "Verified Clear — Routine Monitoring"
        voice_alert_text = "Path verified clear and safe for wheelchairs, elders, and pedestrians."

    annotated_rgb = cv2.cvtColor(annotated_bgr, cv2.COLOR_BGR2RGB)
    annotated_pil = Image.fromarray(annotated_rgb)

    return {
        "engine_used": engine_used,
        "severity_level": severity_level,
        "accessibility_score": accessibility_score,
        "detections": detections,
        "detected_hazards": detections,
        "annotated_image": annotated_pil,
        "wheelchair_safe": wheelchair_safe,
        "elder_safe": elder_safe,
        "wheelchair_advisory": wheelchair_advisory,
        "elder_advisory": elder_advisory,
        "vehicle_advisory": vehicle_advisory,
        "reroute_suggestion": reroute_suggestion,
        "action_track": action_track,
        "voice_alert_text": voice_alert_text,
    }
